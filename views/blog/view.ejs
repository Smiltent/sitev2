
<%- include ("../components/$headerNav.ejs") %>

<div class="blog">
    <div id="header">
        <!-- <a href="/blog">← back</a> -->

        <img src="<%= post.image %>">

        <h1><%= post.title %></h1>
        <p><blockquote><%= post.description %></blockquote></p>

        <hr>
    </div>

    <div id="content">
        <%- post.html %>
    </div>

    <div id="footer">
        <p>posted <%= timeAgo(post.date, post.time) %></p>
        <p>written by smil</p>
    </div>
</div>